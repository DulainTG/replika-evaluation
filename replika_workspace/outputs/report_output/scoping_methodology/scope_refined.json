{
  "paper_summary": {
    "title": "Transverse-Dominant Anisotropic Dispersion and Transient Trapping in 3D Solenoidal Turbulence",
    "main_objective": "The study aims to investigate the connection between large-scale solenoidal forcing, coherent vortex structures, and particle transport (specifically dispersion anisotropy and anomalous transport) in 3D subsonic turbulence.",
    "main_contribution_summary": "The paper identifies a persistent transverse-dominant anisotropy in particle dispersion (where dispersion perpendicular to the flow exceeds parallel dispersion) and demonstrates that vortex trapping is too transient (approx. 7% of an eddy turnover time) to generate sustained anomalous transport or heavy-tailed displacement distributions."
  },
